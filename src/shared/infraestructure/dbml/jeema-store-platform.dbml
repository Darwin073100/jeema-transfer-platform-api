// --------------------
// Enums
// --------------------

Enum LocationEnum {
  venta     // Producto disponible en el área de venta (code: SALE)
  almacen   // Producto en el almacén/bodega (code: STOCK)
  "dañado"  // Producto dañado, no apto para venta (code: DAMAGED)
  viajando  // Producto moviéndose entre sucursales/ubicaciones (code: TRAVELING)
}

Enum AccountTypeEnum {
  Ingreso  // code: INCOME
  Egreso   // code: EXPENSE
}

Enum GenderEnum {
  masculino // code: MALE
  femenino  // code: FEMALE
  otro      // code: OTHER
}

Enum SaleForEnum {
  Menudeo  // code: ONE
  Mayoreo  // code: MANY
  Especial // code: SPECIAL
}

Enum ForSaleEnum {
  kg      // Kilogramo
  l       // Litro
  m       // Metro
  pc      // Pieza
  doc     // Docena
  paquete // Paquete
  caja    // Caja
  set     // Conjunto o Kit
}

Enum SaleStatusEnum {
  inicializada // code: INITIALIZED
  pendiente    // code: PENDING
  completada   // code: COMPLETED
  cancelada    // code: CANCELLED
  reembolsada  // code: REFUNDED
}

Enum TransferStatusEnum {
  Pendiente
  Aprobada
  "En Transito"  // Nota: valor real tiene espacio, no guion bajo (antes era "En_Transito")
  Recibida
  Cancelada
}

Enum ImageOwnerType {
  PRODUCT
  EMPLOYEE
  ESTABLISHMENT
}

Enum EstablishmentDetailTypeEnum {
  PHONE_NUMBER // admite múltiples filas activas por establecimiento
  WHATSAPP     // admite múltiples filas activas por establecimiento
  EMAIL        // singleton por establecimiento
  WEBSITE      // singleton por establecimiento
  FACEBOOK     // singleton por establecimiento
  INSTAGRAM    // singleton por establecimiento
  TIKTOK       // singleton por establecimiento
  SLOGAN       // singleton por establecimiento
}

Enum PrinterConnectionTypeEnum {
  QZ_OS_PRINTER
  QZ_NETWORK
  QZ_USB
}

// --------------------
// Establishment / Address / BranchOffice
// --------------------

Table establishment {
  establishment_id bigint [primary key, increment, not null, unique]
  cloud_establishment_id bigint [null, note: 'ID del establecimiento en la plataforma remota EDYOF, si está enrolado']
  enrollment_key varchar(255) [null, unique, note: 'Llave de enrolamiento a la plataforma cloud EDYOF']
  name varchar(250) [not null, unique]
  logo_url varchar(255) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table establishment_detail {
  establishment_detail_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null, note: 'onDelete CASCADE']
  type EstablishmentDetailTypeEnum [not null]
  value varchar(250) [not null]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  Indexes {
    (establishment_id, type)
    (establishment_id, type) [unique, name: 'IDX_establishment_detail_singleton_per_type', note: 'índice único PARCIAL (WHERE) definido a mano en migración, sólo para tipos no-multivalor; no representable 1:1 en DBML']
  }
}

Table address {
  address_id bigint [primary key, increment, not null, unique]
  street varchar(255) [null]
  external_number varchar(20) [null]
  internal_number varchar(20) [null]
  municipality varchar(100) [not null]
  neighborhood varchar(100) [null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  postal_code varchar(10) [not null]
  country varchar(100) [not null]
  reference text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  note: 'Dueño resuelto por FK única y opcional desde branch_office / employee / suplier / customer (relación 1:0..1 en cada caso, no polimórfica)'
}

Table branch_office {
  branch_office_id bigint [primary key, increment, not null, unique]
  cloud_branch_office_id bigint [null, note: 'ID de la sucursal en la plataforma remota EDYOF, si está enrolada']
  address_id bigint [ref: - address.address_id, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null, note: 'onDelete CASCADE']
  name varchar(250) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

