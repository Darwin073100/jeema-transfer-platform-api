// --------------------
// Cash Management
// --------------------

Table cash_register {
  cash_register_id bigint [primary key, increment, not null, unique]
  branch_office_id bigint [ref: > branch_office.branch_office_id, not null]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table cash_session {
  cash_session_id bigint [primary key, increment, not null, unique]
  cash_register_id bigint [ref: > cash_register.cash_register_id, not null]
  employee_id bigint [ref: > employee.employee_id, not null]
  start_time timestamptz [not null]
  start_balance decimal(14,2) [not null]
  end_time timestamptz [null]
  expected_balance decimal(14,2) [null]
  actual_balance decimal(14,2) [null]
  difference decimal(14,2) [null]
  is_closed boolean [not null, default: false]
  closing_notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

// --------------------
// Employee Management
// --------------------

Table employee_role {
  employee_role_id bigint [primary key, increment, not null, unique]
  name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table employee {
  employee_id bigint [primary key, increment, not null, unique]
  branch_office_id bigint [ref: > branch_office.branch_office_id, not null]
  employee_role_id bigint [ref: > employee_role.employee_role_id, not null]
  address_id bigint [ref: - address.address_id, null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(100) [null, note: 'ya no unique ni not null, cambio respecto al diseño anterior']
  phone_number varchar(25) [null]
  birth_date timestamptz [null, note: 'tipo real timestamptz, no date, a diferencia del diseño anterior']
  gender GenderEnum [null]
  hire_date timestamptz [null, note: 'tipo real timestamptz, no date; ya no es not null']
  termination_date timestamptz [null]
  entry_time time [null]
  exit_time time [null]
  current_salary decimal(10,2) [null, default: 0]
  is_active boolean [not null, default: true]
  photo_url varchar(255) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

// --------------------
// Authentication / Authorization
// --------------------

Table user {
  user_id bigint [primary key, increment, not null, unique]
  employee_id bigint [ref: - employee.employee_id, not null, unique]
  username varchar(100) [not null, unique]
  email varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  last_login timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table role {
  role_id bigint [primary key, increment, not null, unique]
  name varchar(50) [not null, unique]
  description text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table user_role {
  user_role_id bigint [primary key, increment, not null, unique]
  user_id bigint [ref: > user.user_id, not null, note: 'onDelete CASCADE']
  role_id bigint [ref: > role.role_id, not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  note: 'sin constraint UNIQUE sobre (user_id, role_id) en el código actual — a diferencia del diseño anterior, nada impide duplicados a nivel de base de datos'
}

Table permission {
  permission_id bigint [primary key, increment, not null, unique]
  name varchar(100) [not null, unique]
  description text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table role_permission {
  role_permission_id bigint [primary key, increment, not null, unique]
  role_id bigint [ref: > role.role_id, not null, note: 'onDelete CASCADE']
  permission_id bigint [ref: > permission.permission_id, not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  note: 'sin constraint UNIQUE sobre (role_id, permission_id) en el código actual'
}

// --------------------
// Image management (polymorphic, sin FK real)
// --------------------

Table image {
  image_id bigint [primary key, increment, not null, unique]
  owner_type ImageOwnerType [not null]
  owner_id bigint [not null, note: 'apunta a product_id / employee_id / establishment_id según owner_type; sin FK real de Postgres — integridad reforzada a nivel de aplicación vía ImageOwnerGatewayPort']
  storage_key varchar(500) [not null]
  url varchar(1000) [not null]
  mime_type varchar(100) [not null]
  size_bytes integer [not null]
  is_primary boolean [not null, default: false]
  sort_order integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  Indexes {
    (owner_type, owner_id) [name: 'IDX_image_owner']
    (owner_type, owner_id) [unique, name: 'IDX_image_primary_per_owner', note: 'único PARCIAL: WHERE is_primary = true AND deleted_at IS NULL']
  }
}

// --------------------
// Configuration management
// --------------------

Table printer_configuration {
  printer_configuration_id bigint [primary key, increment, not null, unique]
  cash_register_id bigint [ref: - cash_register.cash_register_id, not null, unique, note: 'onDelete CASCADE; relación 1:1 con cash_register']
  label varchar(100) [not null]
  connection_type PrinterConnectionTypeEnum [not null]
  target varchar(250) [not null]
  paper_width_mm smallint [not null]
  auto_print_on_sale boolean [not null, default: false]
  open_cash_drawer boolean [not null, default: false]
  copies smallint [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  note: 'única tabla del modelo sin deleted_at (no tiene soft delete)'
}
