  name varchar(100) [not null]
  description text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table brand {
  brand_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null]
  name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table season {
  season_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null]
  name varchar(100) [not null]
  description text [null]
  date_init date [null]
  date_finish date [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table product {
  product_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null]
  category_id bigint [ref: > category.category_id, not null]
  brand_id bigint [ref: > brand.brand_id, null]
  season_id bigint [ref: > season.season_id, null]
  name varchar(150) [not null]
  sku varchar(50) [null]
  universal_bar_code varchar(100) [null]
  description text [null]
  unit_of_measure ForSaleEnum [not null]
  min_stock_global decimal(18,3) [null, note: 'sin default desde la migración RemoveProductMinStockGlobalDefault']
  image_url varchar(255) [null]
  created_at timestamptz [not null]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  Indexes {
    (establishment_id, name)
    (establishment_id, sku) [unique]
    (establishment_id, universal_bar_code) [unique]
  }
}

// --------------------
// Supplier and Purchase Tables
// --------------------

Table suplier { // sic: mal escrito consistentemente en todo el código, no "corregir"
  suplier_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, not null]
  address_id bigint [ref: - address.address_id, null, unique]
  name varchar(150) [not null]
  phone_number varchar(25) [null]
  rfc varchar(13) [null, unique]
  contact_person varchar(100) [null]
  email varchar(100) [null, unique]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table lot {
  lot_id bigint [primary key, increment, not null, unique]
  product_id bigint [ref: > product.product_id, not null]
  suplier_id bigint [ref: > suplier.suplier_id, null]
  lot_number varchar(50) [not null]
  purchase_price decimal(12,4) [not null]
  purchase_unit ForSaleEnum [not null, note: 'unidad en la que se compró este lote (nuevo respecto al diseño anterior)']
  initial_quantity decimal(18,3) [not null]
  expiration_date date [null]
  manufacturing_date date [null]
  received_date date [not null, default: `CURRENT_DATE`]
  created_at timestamptz [not null]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  Indexes {
    (product_id, lot_number) [unique]
  }
}

Table lot_unit_purchase {
  lot_unit_purchase_id bigint [primary key, increment, not null, unique]
  lot_id bigint [ref: > lot.lot_id, not null]
  purchase_price decimal(18,2) [not null]
  purchase_quantity decimal(18,3) [not null]
  unit ForSaleEnum [not null]
  units_in_purchase_unit decimal(18,3) [not null, note: 'cantidad de unidades base por unidad de compra, ej. 1 paquete = 10 bolsas']
  created_at timestamptz [not null]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

// --------------------
// Inventory Management
// --------------------

Table inventory {
  inventory_id bigint [primary key, increment, not null, unique]
  product_id bigint [ref: - product.product_id, not null, unique, note: 'relación 1:1 real con product (no por sucursal, cambio respecto al diseño anterior)']
  branch_office_id bigint [ref: > branch_office.branch_office_id, not null]
  internal_bar_code varchar(100) [null]
  sale_price_one decimal(12,2) [null]
  sale_price_many decimal(12,2) [null]
  sale_quantity_many decimal(18,4) [null]
  sale_price_special decimal(12,2) [null]
  min_stock_branch decimal(18,3) [null]
  max_stock_branch decimal(18,3) [null]
  is_sellable boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table inventory_item {
  inventory_item_id bigint [primary key, increment, not null, unique]
  inventory_id bigint [ref: > inventory.inventory_id, not null]
  location LocationEnum [null, note: 'ubicación física/estado dentro de la sucursal']
  quantity_on_hand decimal(18,3) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table transfer {
  transfer_id bigint [primary key, increment, not null, unique]
  inventory_id bigint [ref: > inventory.inventory_id, null]
  from_branch_office_id bigint [ref: > branch_office.branch_office_id, null]
  from_location LocationEnum [null]
  to_branch_office_id bigint [ref: > branch_office.branch_office_id, not null]
  to_location LocationEnum [not null]
  quantity_required decimal(18,3) [not null]
  quantity_transferred decimal(18,3) [null]
  requested_by_employee_id bigint [ref: > employee.employee_id, not null]
  approved_by_employee_id bigint [ref: > employee.employee_id, null]
  shipped_by_employee_id bigint [ref: > employee.employee_id, null]
  received_by_employee_id bigint [ref: > employee.employee_id, null]
  transfer_request_date timestamptz [not null]
  transfer_shipped_date timestamptz [null]
  transfer_received_date timestamptz [null]
  status TransferStatusEnum [not null]
  notes text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]

  note: 'A diferencia del diseño anterior: ya no tiene tracking_number, y ya no existen remote_transfer ni transfer_item (traspasos multi-producto por lote) en el modelo actual'
}

// --------------------
// Sales Related Tables
// --------------------

Table customer {
  customer_id bigint [primary key, increment, not null, unique]
  establishment_id bigint [ref: > establishment.establishment_id, null]
  address_id bigint [ref: - address.address_id, null, unique]
  first_name varchar(150) [not null]
  last_name varchar(100) [null]
  sale_default boolean [not null]
  company_name varchar(150) [null]
  phone_number varchar(25) [null]
  rfc varchar(13) [null]
  email varchar(100) [null, unique]
  customer_type varchar(50) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table payment_method {
  payment_method_id bigint [primary key, increment, not null, unique]
  name varchar(50) [not null, unique]
  requires_reference boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table sale {
  sale_id bigint [primary key, increment, not null, unique]
  branch_office_id bigint [ref: > branch_office.branch_office_id, not null]
  customer_id bigint [ref: > customer.customer_id, not null, note: 'ya no es nullable, cambio respecto al diseño anterior']
  employee_id bigint [ref: > employee.employee_id, not null]
  cash_session_id bigint [ref: > cash_session.cash_session_id, not null]
  sub_total_amount decimal(14,2) [not null, default: 0]
  discount_amount decimal(14,2) [not null, default: 0]
  tax_amount decimal(14,2) [not null, default: 0]
  total_amount decimal(14,2) [not null, default: 0]
  in_amount decimal(14,2) [not null, default: 0]
  out_amount decimal(14,2) [not null, default: 0]
  status SaleStatusEnum [not null]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table sale_detail {
  sale_detail_id bigint [primary key, increment, not null, unique]
  sale_id bigint [ref: > sale.sale_id, not null]
  product_id bigint [ref: > product.product_id, not null]
  inventory_id bigint [ref: > inventory.inventory_id, not null]

  product_name_at_sale varchar(100) [not null]
  product_description_at_sale text [null]
  product_bar_code_at_sale varchar(100) [not null]
  product_brand_at_sale varchar(100) [null]
  product_category_at_sale varchar(100) [null]
  product_unit_at_sale varchar(20) [not null, note: 'almacenado como varchar, no como enum de Postgres, a diferencia de product.unit_of_measure']

  quantity decimal(18,3) [not null]
  unit_price_at_sale decimal(12,2) [not null]
  regular_price_at_sale decimal(12,2) [not null]
  discount_item decimal(12,2) [not null, default: 0]
  sale_for SaleForEnum [not null]
  subtotal_item decimal(14,2) [not null]
  notes text [null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table sale_payment {
  sale_payment_id bigint [primary key, increment, not null, unique]
  sale_id bigint [ref: > sale.sale_id, not null]
  payment_method_id bigint [ref: > payment_method.payment_method_id, not null]
  amount_paid decimal(18,2) [not null]
  reference_number varchar(100) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

Table returns {
  returns_id bigint [primary key, increment, not null, unique]
  sale_detail_id bigint [ref: > sale_detail.sale_detail_id, not null]
  employee_id bigint [ref: > employee.employee_id, not null]
  inventory_id bigint [ref: > inventory.inventory_id, not null]
  quantity_return decimal(18,3) [not null]
  amount_return decimal(12,2) [not null, default: 0]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]
  deleted_at timestamptz [null]
}

